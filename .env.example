# Copie este arquivo para ".env" e preencha com seus dados.
# NUNCA compartilhe seu .env nem suba ele pro GitHub.

# Chave da API do Gemini, gerada em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Porta em que o servidor local vai rodar
PORT=3000

# Idioma da transcricao (pt-BR = portugues do Brasil)
LANGUAGE_CODE=pt-BR

# Tempo (em milissegundos) sem nenhuma transcricao chegar, MESMO com fala
# ativa no microfone, antes do sistema forcar uma reconexao automatica.
# Isso protege contra o bug conhecido de "sessao trava e para de transcrever
# silenciosamente" relatado no forum oficial do Google AI.
WATCHDOG_TIMEOUT_MS=20000
